#!/bin/sh
#
# Recusa o push quando algum commit dele tem import sem o arquivo junto.
#
# Nasceu do deploy vermelho de 20/08/2026. `cargasLuft.ts` importava
# `../Cobertura` e o `Cobertura.ts` ficou fora do `git add`; na máquina de quem
# escreveu compilava, no Railway não. O `tsc` local não pega essa classe porque
# ele lê o disco, e o disco estava certo — quem estava errado era o commit.
#
# CHECA TODOS OS COMMITS DO PUSH, não só a ponta. O Railway construiu eb30c75,
# um commit do MEIO: a ponta já tinha o arquivo e o deploy quebrou assim mesmo.
# Enquanto um host puder escolher um commit intermediário, "a ponta está verde"
# não é garantia de nada.
#
# Custa ~0,6 s por commit. Para pular num aperto: `git push --no-verify` — e aí
# o risco é seu, conscientemente.
#
# Instalado por `core.hooksPath=.githooks`. Numa cópia nova do repositório:
#     git config core.hooksPath .githooks

VERIFICADOR="iara-os/apps/web/scripts/verificar-importacoes.mjs"
TETO=25

raiz=$(git rev-parse --show-toplevel)
[ -f "$raiz/$VERIFICADOR" ] || {
  echo "pre-push: $VERIFICADOR não existe — verificação PULADA (isto não é um aval)" >&2
  exit 0
}

command -v node >/dev/null 2>&1 || {
  echo "pre-push: node não está no PATH — verificação PULADA (isto não é um aval)" >&2
  exit 0
}

zerado="0000000000000000000000000000000000000000"
falhou=0

while read -r _ref_local sha_local _ref_remoto sha_remoto; do
  # Deleção de branch: não há árvore para conferir.
  [ "$sha_local" = "$zerado" ] && continue

  if [ "$sha_remoto" = "$zerado" ]; then
    # Branch nova no remoto: não há base. Confere o que ainda não está em
    # nenhum outro ref remoto, para não reprocessar a história inteira.
    commits=$(git rev-list "$sha_local" --not --remotes)
  else
    commits=$(git rev-list "$sha_remoto..$sha_local")
  fi

  [ -z "$commits" ] && continue

  total=$(printf '%s\n' "$commits" | wc -l | tr -d ' ')
  if [ "$total" -gt "$TETO" ]; then
    # Cortar em silêncio faria o hook parecer que cobriu tudo. Diz o que
    # deixou de fora.
    echo "pre-push: $total commits no push; conferindo apenas os $TETO mais" \
         "recentes. Os $((total - TETO)) mais antigos NÃO foram conferidos." >&2
    commits=$(printf '%s\n' "$commits" | head -n "$TETO")
  fi

  for commit in $commits; do
    if ! node "$raiz/$VERIFICADOR" "$commit" >/dev/null 2>&1; then
      echo "" >&2
      echo "=== $commit  $(git log -1 --format=%s "$commit") ===" >&2
      node "$raiz/$VERIFICADOR" "$commit" >&2
      falhou=1
    fi
  done
done

if [ "$falhou" -ne 0 ]; then
  echo "push RECUSADO: commit com import sem arquivo chegaria ao remoto e" >&2
  echo "quebraria o build lá, mesmo compilando aqui." >&2
  echo "" >&2
  exit 1
fi

exit 0
