node_modules/
.next/
# uma instância por porta — ver distDir em next.config.mjs
.next-*/
out/
# O executável do braço (npm run empacotar:braco). São ~82 MB, dos quais 99% é
# o runtime do Node — versionar isto encheria a história do repositório com um
# binário que se regenera em vinte segundos. Ele é publicado como Release, e o
# endereço vai em NEXT_PUBLIC_IARA_INSTALADOR.
dist/
.env
.env.local
*.tsbuildinfo
next-env.d.ts
dados/memoria/
# Jornal das operações de escrita: dado de runtime por operador, mesma classe
# dos shards. Versionar isto publicaria o que cada pessoa mandou a IARA fazer.
dados/operacoes/
# Lembretes, um arquivo por operador. `Agenda.ts` diz por que eles são tão
# privados quanto o histórico: "um lembrete diz o que a pessoa tem medo de
# esquecer". A pasta só passou a nascer com frequência quando a persistência
# aprendeu a cair para arquivo por tabela ausente — antes disso o descuido era
# latente. Um `git add -A` numa máquina de operador publicaria a agenda dela.
dados/agenda/
# PDFs que a extração de texto lê. Documento de cliente não entra na história do
# repositório; a bancada de auditoria gera o dela e apaga.
dados/documentos/
# Livro da camada proativa: o que a IARA aprendeu sobre quando vale
# interromper cada pessoa — o que ela ignorou, o que rejeitou, a que horas
# trabalha. Mesma classe dos shards e da agenda; versionar isto publicaria o
# comportamento de cada operador.
dados/proativo/

# gerados pelo beforeDevCommand do apps/desktop (ver copiar-bolha.mjs).
# A fonte é public/marca/iara-esfera.png, essa sim versionada.
public/bolha.html
public/iara-esfera.png
# Sobra do tempo em que a bolha carregava o rosto cromado. Fica para a cópia
# antiga em disco não voltar ao versionamento por descuido.
public/iara-simbolo.png
