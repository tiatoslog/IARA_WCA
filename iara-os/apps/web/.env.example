# Copie para .env.local e preencha.
# Sem chave, a IARA continua 100% funcional em modo local (clima, banco, RAG,
# busca web). Só a camada de raciocínio profundo (Claude) fica indisponível,
# e ela avisa isso explicitamente em vez de inventar resposta.
ANTHROPIC_API_KEY=

# Modelo e esforço da camada de nuvem.
IARA_MODELO=claude-opus-5
IARA_ESFORCO=low

# Porta do motor cognitivo (WebSocket).
IARA_PORTA=8787

# Endereço que o navegador usa para falar com o motor.
NEXT_PUBLIC_IARA_WS=ws://localhost:8787

# Coordenadas do perímetro operacional (Open-Meteo). Padrão: Cuiabá/MT.
IARA_LATITUDE=-15.6014
IARA_LONGITUDE=-56.0979
IARA_CIDADE=Cuiabá
