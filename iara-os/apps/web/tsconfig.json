{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "verbatimModuleSyntax": false,
    "forceConsistentCasingInFileNames": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next*/types/**/*.ts",
    ".next-3001/types/**/*.ts",
    ".next-3010/types/**/*.ts",
    ".next-3011/types/**/*.ts",
    ".next-3012/types/**/*.ts",
    ".next-3056/types/**/*.ts",
    ".next-3058/types/**/*.ts",
    ".next-3099/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-3057/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
