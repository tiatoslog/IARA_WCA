{
  "name": "iara-os-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false servidor/principal.ts --dev",
    "build": "next build",
    "start": "tsx servidor/principal.ts",
    "braco": "tsx servidor/braco/principal.ts",
    "braco:entrar": "tsx scripts/braco-entrar.ts",
    "empacotar:braco": "tsx scripts/empacotar-braco.ts",
    "celular": "node scripts/celular.mjs",
    "pops": "tsx scripts/geracao/ingerir-pops.ts",
    "marca": "tsx scripts/geracao/gerar-marca.ts",
    "icones": "tsx scripts/geracao/gerar-icones.ts",
    "vozes": "node scripts/diagnostico/vozes.mjs",
    "medir:voz": "tsx scripts/diagnostico/medir-voz.ts",
    "limpar": "node -e \"const f=require('node:fs');for(const d of f.readdirSync('.').filter(n=>n==='.next'||n.startsWith('.next-')))f.rmSync(d,{recursive:true,force:true})\"",
    "docs": "tsx scripts/docs/gerar-documentacao.mjs",
    "test": "node --import tsx --test \"testes/**/*.test.ts\"",
    "verificar": "node scripts/diagnostico/verificar-caminhos.mjs && node scripts/diagnostico/verificar-glsl.mjs && node scripts/varrer-segredos.mjs --tudo && tsc --noEmit && npm test",
    "varrer-segredos": "node scripts/varrer-segredos.mjs",
    "campanha": "node --import tsx testes/campanha/executar.ts",
    "superficie": "node --import tsx testes/validacao/superficieCLI.ts",
    "veredito": "node --import tsx testes/validacao/veredito.ts",
    "bateria": "node --import tsx testes/validacao/executar.ts",
    "confiabilidade": "node --import tsx testes/confiabilidade/executar.ts",
    "benchmark-analitico": "node --import tsx testes/holdout/benchmark.ts",
    "inventario": "node --import tsx scripts/inventario-habilidades.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@ricky0123/vad-web": "^0.0.30",
    "@supabase/supabase-js": "^2.112.2",
    "dotenv": "^16.4.7",
    "msedge-tts": "^2.0.7",
    "next": "^15.5.23",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "tsx": "^4.19.2",
    "ws": "^8.18.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "sharp": "^0.35.3"
  }
}
