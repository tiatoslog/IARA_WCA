{
  "name": "iara-os-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n motor,web -c magenta,cyan \"npm:dev:motor\" \"npm:dev:web\"",
    "dev:web": "next dev -p 3000",
    "dev:motor": "tsx watch servidor/index.ts",
    "build": "next build",
    "limpar": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true})\"",
    "start": "concurrently -k -n motor,web \"tsx servidor/index.ts\" \"next start -p 3000\"",
    "verificar": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "dotenv": "^16.4.7",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
