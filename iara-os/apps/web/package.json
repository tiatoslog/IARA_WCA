    "three": "^0.180.0",
    "tsx": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.3"
